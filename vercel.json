{
  "rewrites": [
    {
      "source": "/:slug((?!api|login|register|forgot-password|catalogs|followed-catalogs|profile|admin|assets).*)/p/:productId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Discordbot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/og?slug=:slug&productId=:productId"
    },
    {
      "source": "/:slug((?!api|login|register|forgot-password|catalogs|followed-catalogs|profile|admin|assets|icon\\.png|favicon-32x32\\.png|favicon-192x192\\.png|apple-touch-icon\\.png|manifest\\.webmanifest|sw\\.js|vite\\.svg)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Discordbot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
